{
  "name": "captable-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "tsc --noEmit && vite build && node tools/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests tools eslint.config.js vite.config.ts",
    "format:check": "prettier --check src tests tools eslint.config.js vite.config.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "smoke": "node tools/smoke.mjs",
    "shot": "node tools/shot.mjs",
    "og": "node tools/og.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
